{
  "name": "algach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Transit schedule layout generator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "proof": "tsx scripts/proof.ts",
    "proof:png": "tsx scripts/proof.ts && node scripts/shoot.mjs",
    "build:single": "vite build --config vite.config.single.ts && node scripts/bundle-single.mjs",
    "check:single": "node scripts/check-single.mjs",
    "check:app": "node scripts/check-app.mjs",
    "examples": "tsx scripts/make-examples.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.8"
  }
}
