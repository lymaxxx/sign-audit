{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Algach",
  "version": "0.1.0",
  "identifier": "app.algach.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Algach",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Visible",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Transit schedule layout generator",
    "longDescription": "Turns planned timetables into print-ready schedule sheets, one per stop.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
